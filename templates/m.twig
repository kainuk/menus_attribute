{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}

{% import _self as menus %}

{#
  We call a macro which calls itself to render the full tree.
  @see http://twig.sensiolabs.org/doc/tags/macro.html
#}
{{ menus.menu_links(items, attributes, 0) }}
{{kint(items)}}
{% macro menu_links(items, attributes, menu_level) %}
  {# kint(items|keys) #}
  
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('menu') }}>
    {% else %}
      <ul class="menu">
    {% endif %}
     
    {% for item in items %}
   {#  {{ kint(test_menu(items|keys[loop.index0])) }}#}
      {%
        set classes = [
          'menu-item',
          item.is_expanded ? 'menu-item--expanded',
          item.is_collapsed ? 'menu-item--collapsed',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
      {% set my_menu_attributes = menus_attribute(items|keys[loop.index0]) %}
      {% set menu_attributes=[]  %}
      {% if my_menu_attributes %}
        {% if my_menu_attributes['id'] %}
          {% set menu_attributes= { id : my_menu_attributes['id'] } %}
        {% endif %}
        {% if my_menu_attributes['name'] %}
          {% set menu_attributes=menu_attributes|merge({ name : my_menu_attributes['name'] }) %}
        {% endif %}
        {% if my_menu_attributes['rel'] %}
          {% set menu_attributes=menu_attributes|merge({ rel : my_menu_attributes['rel'] }) %}
        {% endif %}
        {% if my_menu_attributes['target'] %}
          {% set menu_attributes=menu_attributes|merge({ target : my_menu_attributes['target'] }) %}
        {% endif %}
        {% if my_menu_attributes['style'] %}
          {% set menu_attributes=menu_attributes|merge({ style : my_menu_attributes['style'] }) %}
        {% endif %}
        {% if my_menu_attributes['accesskey'] %}
          {% set menu_attributes=menu_attributes|merge({ accesskey : my_menu_attributes['accesskey'] }) %}
        {% endif %}
        {% if my_menu_attributes['class'] %}
          {% set menu_attributes=menu_attributes|merge({ class : my_menu_attributes['class'] }) %}
        {% endif %}
        {% if my_menu_attributes['item_class'] %}
          {% set classes = classes|merge([my_menu_attributes['item_class']]) %}
        {% endif %} 
      {% endif %}
      <li{{ item.attributes.addClass(classes) }}
        {% if my_menu_attributes['item_id'] %}
          {{ item.attributes.setAttribute('id', my_menu_attributes['item_id']) }}
        {% endif %}
        {% if my_menu_attributes['item_style'] %}
          {{ item.attributes.setAttribute('style',my_menu_attributes['item_style']) }}
        {% endif %}
      >
        {{ link(item.title, item.url, menu_attributes) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
